{
    "extends": "@tsconfig/node24/tsconfig.json",
    "include": ["src"],
    "compilerOptions":{
        "paths":{
            "@plugins/*" : ["./src/plugins/*"],
            "@services/*" : ["./src/services/*"],
            "@schemas/*" : ["./src/schemas/*"],
            "@shared/*" : ["../shared/*"],
            "@utils/*" : ["./src/utils/*"],
        },
         "typeRoots" : ["node_modules/@types"],
         "rewriteRelativeImportExtensions": true,
         "allowImportingTsExtensions": true
    }
}